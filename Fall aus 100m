import numpy as np
import matplotlib.pyplot as plt

g= 9.81
t=0
dt=0.1

v = 0 
y = 100

strecke=[]
zeiten=[]

while y > 0:
    v = v + g*dt
    y = y - v*dt


    zeiten.append(t)
    strecke.append(y)

    t=t+dt

print("Endzeit:", t)

plt.plot(zeiten, strecke)
plt.xlabel("Zeit (s)")
plt.ylabel("Strecke (m)")
plt.title("Freier Fall aus 100m")
plt.show()
